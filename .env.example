# Copie para .env (cp .env.example .env) e troque a senha.
# O .env fica só na sua máquina: ele está no .gitignore e nunca vai para o repositório.
# É lido pelo Docker Compose (compose.yaml) e pela API no perfil prod.

POSTGRES_DB=roteirizacao
POSTGRES_USER=roteirizacao
POSTGRES_PASSWORD=troque-esta-senha

# Porta do PostgreSQL na sua máquina. Mude se a 5432 já estiver em uso.
POSTGRES_PORT=5432
