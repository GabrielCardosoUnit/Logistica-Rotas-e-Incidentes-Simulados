<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.logistica</groupId>
    <artifactId>roteirizacao-logistica</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Roteirização Logística</name>
    <description>Rotas e incidentes simulados (MVP acadêmico)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>api</module>
        <module>desktop</module>
    </modules>

    <build>
        <plugins>
            <!--
                Javadoc. Por módulo:  ./mvnw javadoc:javadoc        (api/target/reports/apidocs)
                Tudo junto:           ./mvnw javadoc:aggregate      (target/reports/apidocs)
                A versão vem do spring-boot-starter-parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <locale>pt_BR</locale>
                    <doctitle>Roteirização Logística ${project.version}</doctitle>
                    <windowtitle>Roteirização Logística</windowtitle>
                    <!-- Verifica HTML, referências, sintaxe e cobra comentário em todo membro público/protegido. -->
                    <doclint>all</doclint>
                    <additionalOptions>
                        <additionalOption>-Xmaxwarns</additionalOption>
                        <additionalOption>10000</additionalOption>
                    </additionalOptions>
                    <failOnWarnings>false</failOnWarnings>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
